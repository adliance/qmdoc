<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings for "dotnet test -coverage-settings", see https://aka.ms/dotnet-test/coverage -->
<Configuration>
  <Format>cobertura</Format>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]Adliance\.QmDoc\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
